{
  "entities": {
    "CommercialCampaign": {
      "title": "Commercial Campaign",
      "description": "A saved commercial ad campaign with its script, voice configuration, audio, and scene storyboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the commercial campaign",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Title or headline of the commercial campaign",
          "maxLength": 200
        },
        "script": {
          "type": "string",
          "description": "The complete advert voiceover/jingle script",
          "maxLength": 10000
        },
        "voice": {
          "type": "string",
          "description": "Selected voice identifier",
          "maxLength": 100
        },
        "voiceName": {
          "type": "string",
          "description": "Display name of the voice",
          "maxLength": 100
        },
        "timbre": {
          "type": "string",
          "description": "Acoustic pitch and timbre modification",
          "enum": ["standard", "baritone", "bass"]
        },
        "style": {
          "type": "string",
          "description": "Performance dialect or style",
          "maxLength": 100
        },
        "audioUrl": {
          "type": "string",
          "description": "Audio stream or data URL for the rendered commercial track",
          "maxLength": 2000000
        },
        "duration": {
          "type": "number",
          "description": "Audio track duration in seconds"
        },
        "scenes": {
          "type": "string",
          "description": "JSON serialized string of the 8 synchronized advert scenes and visuals",
          "maxLength": 500000
        },
        "aspectRatio": {
          "type": "string",
          "description": "Visual format aspect ratio",
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO or server format",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 50
        }
      },
      "required": ["title", "script", "voice", "style"]
    }
  },
  "firestore": {
    "/commercials/{commercialId}": {
      "schema": {
        "$ref": "#/entities/CommercialCampaign"
      },
      "description": "Collection of saved LegitAfrica commercial ad campaigns for instant preview and restoration."
    }
  }
}
